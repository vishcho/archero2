{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "roster.schema.json",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "date", "theme", "status", "roster"],
  "properties": {
    "id": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "date": { "type": "string", "minLength": 1 },
    "theme": { "type": "string", "minLength": 1 },
    "status": { "enum": ["upcoming", "in_progress", "finished"] },
    "notes": { "type": "array", "items": { "type": "string" } },
    "roster": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "player_id": { "type": "string", "pattern": "^\\d+$" },
          "name": { "type": "string", "minLength": 1 },
          "spirit_awe": { "enum": ["紅", "金", "金1", "金2", "金3", "未知"] },
          "spirit_assist": { "enum": ["紅", "金", "金1", "金2", "金3", "未知"] },
          "enchants": {
            "type": "array",
            "items": {
              "anyOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["text", "color"],
                  "properties": {
                    "text": { "type": "string", "minLength": 1 },
                    "color": { "enum": ["紅", "黃", null] }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
