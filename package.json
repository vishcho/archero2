{
  "name": "archero2-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node tools/dev-server.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "test": "node --test",
    "validate:contracts": "node tools/validate-contracts.mjs",
    "validate:data": "node tools/validate-season.mjs --all",
    "validate:players": "node tools/validate-players.mjs",
    "validate:results": "node tools/validate-all-tournament-results.mjs",
    "predictions:preview": "node tools/generate-prediction.mjs",
    "predictions:web-preview": "node tools/generate-prediction.mjs --web-preview",
    "predictions:publish": "node tools/generate-prediction.mjs --publish --confirm",
    "social-preview": "node tools/generate-social-preview.mjs",
    "social-preview:check": "node tools/generate-social-preview.mjs --check",
    "validate": "npm run validate:data && npm run validate:players && npm run validate:results",
    "docs:build": "node tools/build-docs-index.mjs",
    "docs:check": "node tools/build-docs-index.mjs --check",
    "check": "npm run test && npm run validate:contracts && npm run validate && npm run docs:check && npm run social-preview:check"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "ajv": "^8.20.0"
  }
}
