{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prediction.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "season_id",
    "status",
    "source",
    "published_at",
    "ruleset",
    "source_document",
    "coverage",
    "groups"
  ],
  "properties": {
    "season_id": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "status": { "enum": ["preview", "published"] },
    "source": {
      "enum": [
        "snapshot",
        "document_reconstruction",
        "retrospective",
        "preview"
      ]
    },
    "published_at": { "type": "string", "format": "date-time" },
    "ruleset": { "type": "string", "minLength": 1 },
    "source_document": { "type": ["string", "null"] },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["power", "qualifier", "history"],
      "properties": {
        "power": { "$ref": "#/$defs/coverage" },
        "qualifier": { "$ref": "#/$defs/coverage" },
        "history": { "$ref": "#/$defs/coverage" }
      }
    },
    "groups": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "picks"],
        "properties": {
          "id": { "type": "integer", "minimum": 1, "maximum": 8 },
          "picks": {
            "type": "array",
            "minItems": 7,
            "maxItems": 7,
            "items": { "$ref": "#/$defs/pick" }
          }
        }
      }
    }
  },
  "$defs": {
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "total"],
      "properties": {
        "available": { "type": "integer", "minimum": 0 },
        "total": { "const": 64 }
      }
    },
    "player": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "player_id": { "type": ["string", "null"], "pattern": "^\\d+$" }
      }
    },
    "pick": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "round",
        "slot",
        "p1",
        "p2",
        "selected_side",
        "confidence",
        "basis",
        "reason",
        "missing",
        "forced",
        "depends_on"
      ],
      "properties": {
        "round": { "enum": ["R1", "R2", "決賽"] },
        "slot": { "enum": ["A", "B", "C", "D", "upper", "lower", "final"] },
        "p1": { "$ref": "#/$defs/player" },
        "p2": { "$ref": "#/$defs/player" },
        "selected_side": { "enum": ["p1", "p2"] },
        "confidence": { "enum": ["high", "medium", "low"] },
        "basis": {
          "enum": [
            "previous_performance",
            "power",
            "qualifier_rank",
            "qualifier_time",
            "fixed_slot",
            "legacy_guide"
          ]
        },
        "reason": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "#/$defs/evidence" },
        "missing": {
          "type": "array",
          "items": { "enum": ["history", "power", "qualifier"] },
          "uniqueItems": true
        },
        "forced": { "type": "boolean" },
        "depends_on": {
          "type": "array",
          "items": { "enum": ["A", "B", "C", "D", "upper", "lower"] },
          "uniqueItems": true
        },
        "correction": { "type": "string", "minLength": 1 }
      }
    },
    "nullableString": { "type": ["string", "null"] },
    "nullableInteger": { "type": ["integer", "null"] },
    "historyEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["progress", "time"],
      "properties": {
        "progress": { "$ref": "#/$defs/nullableString" },
        "time": { "$ref": "#/$defs/nullableString" }
      }
    },
    "qualifierEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rank", "time"],
      "properties": {
        "rank": { "$ref": "#/$defs/nullableInteger" },
        "time": { "$ref": "#/$defs/nullableString" }
      }
    },
    "pairStrings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p1", "p2"],
      "properties": {
        "p1": { "$ref": "#/$defs/nullableString" },
        "p2": { "$ref": "#/$defs/nullableString" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["previous_performance", "power", "qualifier"],
      "properties": {
        "previous_performance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["p1", "p2"],
          "properties": {
            "p1": { "$ref": "#/$defs/historyEvidence" },
            "p2": { "$ref": "#/$defs/historyEvidence" }
          }
        },
        "power": { "$ref": "#/$defs/pairStrings" },
        "qualifier": {
          "type": "object",
          "additionalProperties": false,
          "required": ["p1", "p2"],
          "properties": {
            "p1": { "$ref": "#/$defs/qualifierEvidence" },
            "p2": { "$ref": "#/$defs/qualifierEvidence" }
          }
        }
      }
    }
  }
}
